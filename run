#!/usr/bin/env bash

if [ ! -d ".venv" ]; then 
    python3 -m venv .venv
	source .venv/bin/activate
	python3 -m pip install -r ./setup/requirements.txt

	else 
	source .venv/bin/activate
fi
	
echo "Starting Audio Signal Processor..." 

#pipe_input=./program/data/pipe_input
#[[ -p "$pipe_input" ]] || mkfifo "$pipe_input"	
# <pipes>
pipe_sound=./program/data/pipe_sound
[[ -p "$pipe_sound" ]] || mkfifo "$pipe_sound"

# playback process
ffplay -f s16le -ar 44100 -ch_layout mono -nodisp -fflags nobuffer -flags low_delay - \
	< "$pipe_sound" 2> /dev/null &
playback_pid=$!

clear
# input process
echo "play..."
{
	while true; do 
		read -rsn1 key 
		echo $key
	done
}| ./program/src/core/render.py > "$pipe_sound"